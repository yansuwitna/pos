generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN      // Laporan & Manajemen User
  CASHIER    // Transaksi POS saja
  WAREHOUSE  // Input Barang saja
}

enum ItemType {
  GOODS
  SERVICE
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Store {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  address   String?
  phone     String?
  greeting  String?
  logo      String?  @db.LongText
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  categories         Category[]
  products           Product[]
  customers          Customer[]
  transactions       Transaction[]
  receivablePayments ReceivablePayment[]
  purchases          Purchase[]
  debtPayments       DebtPayment[]
  suppliers          Supplier[]
  returns            Return[]
  orders             Order[]
  expenses           Expense[]
  stockOpnames       StockOpname[]
  discountRules      DiscountRule[]
  capitals           Capital[]
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  role      Role     @default(CASHIER)
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  storeId   String?
  store     Store?   @relation(fields: [storeId], references: [id])
  
  transactions Transaction[]
  purchases    Purchase[]
  returns      Return[]
  orders       Order[]
  receivablePayments ReceivablePayment[]
  debtPayments       DebtPayment[]
  expenses           Expense[]
  stockOpnames       StockOpname[]
  capitals           Capital[]
}

model Category {
  id        String    @id @default(cuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id])
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id              String    @id @default(cuid())
  storeId         String
  store           Store     @relation(fields: [storeId], references: [id])
  sku             String?   
  name            String
  type            ItemType  @default(GOODS)
  price           Float
  cost            Float
  stock           Int       @default(0)
  discountPercent Float     @default(0)
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  transactionItems TransactionItem[]
  purchaseItems    PurchaseItem[]
  returnItems      ReturnItem[]
  orderItems       OrderItem[]
  opnameItems      StockOpnameItem[]
  
  @@unique([storeId, sku])
}

model Customer {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  name      String
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  transactions Transaction[]
}

enum PaymentStatus {
  PAID
  UNPAID
  PARTIAL
}

model Transaction {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  total       Float
  discount    Float    @default(0)
  tax         Float    @default(0)
  grandTotal  Float
  payment     Float
  change      Float
  createdAt   DateTime @default(now())

  items       TransactionItem[]
  
  // Hutang Pelanggan (Piutang Toko)
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  paymentStatus PaymentStatus @default(PAID)
  amountPaid    Float     @default(0)
  dueDate       DateTime?
  
  receivablePayments ReceivablePayment[]
}

model ReceivablePayment {
  id            String      @id @default(cuid())
  storeId       String
  store         Store       @relation(fields: [storeId], references: [id])
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  amount        Float
  date          DateTime    @default(now())
  notes         String?
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
}

model TransactionItem {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  quantity      Int
  price         Float
  subtotal      Float
  productName   String?
}

model Purchase {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  totalCost   Float    // Total biaya restock
  createdAt   DateTime @default(now())
  
  items       PurchaseItem[]

  // Hutang ke Supplier
  paymentStatus PaymentStatus @default(PAID)
  amountPaid    Float         @default(0)
  dueDate       DateTime?
  
  debtPayments  DebtPayment[]
}

model DebtPayment {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  amount      Float
  date        DateTime @default(now())
  notes       String?
  userId        String?
  user        User?    @relation(fields: [userId], references: [id])
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  unitCost    Float
  subtotal    Float
  productName String?
}

model Supplier {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  name      String
  contact   String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]
  returns   Return[]
  orders    Order[]
}

model Return {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  notes       String?
  createdAt   DateTime @default(now())
  
  items       ReturnItem[]
}

model ReturnItem {
  id          String   @id @default(cuid())
  returnId    String
  return      Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  reason      String?
  productName String?
}

model Order {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  notes       String?
  createdAt   DateTime @default(now())
  
  items       OrderItem[]
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  productName String?
}

model Expense {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  category    String   // Operasional, Gaji, dll
  amount      Float
  description String?
  date        DateTime @default(now())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
}

model StockOpname {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  notes     String?
  createdAt DateTime @default(now())

  items     StockOpnameItem[]
}

model StockOpnameItem {
  id          String   @id @default(cuid())
  opnameId    String
  opname      StockOpname @relation(fields: [opnameId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  productName String?
  
  systemStock Int
  actualStock Int
  difference  Int      // selisih = actualStock - systemStock
  notes       String?
}

model DiscountRule {
  id              String   @id @default(cuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id])
  name            String
  minItemQuantity Int?
  minTransaction  Float?
  discountPercent Float
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Capital {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  amount      Float
  description String?
  date        DateTime @default(now())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
}
